{
  "name": "e-jamaat",
  "version": "1.0.6",
  "main": "electron.js",
  "scripts": {
    "predev": "npx kill-port 5173 5174 || true",
    "dev": "cross-env NODE_ENV=development concurrently \"cd react_ejamaat && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "cd react_ejamaat && npm run build && cd .. && npx electron-builder --win --x64 --publish never && npm run verify-release",
    "publish": "cd react_ejamaat && npm run build && cd .. && npx electron-builder --win --x64 --publish always",
    "test": "node --test tests/appUpdater.test.js tests/updateRelease.test.js",
    "verify-release": "node scripts/verify-update-release.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jazeel5/Ullal_Jamaat_Electron.git"
  },
  "build": {
    "appId": "com.dataqueuesystems.ejamaat",
    "productName": "E-Jamaat",
    "files": [
      "electron.js",
      "preload.js",
      "server/**/*",
      "react_ejamaat/dist/**/*",
      "assets/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "E-Jamaat",
      "artifactName": "E-Jamaat-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "public/logo.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "icon": "public/logo.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jazeel5",
        "repo": "Ullal_Jamaat_Electron",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "E-Jamaat-Portable-${version}.${ext}"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.6.1",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "fs": "^0.0.1-security",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.3",
    "os": "^0.1.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3",
    "wait-on": "^8.0.3",
    "js-yaml": "^4.1.0"
  }
}